---
import NavBar from "@/components/islands/NavBar";
import { getProfile } from "@/data/profile";
import { LOCALE_LABELS, LOCALES, type Locale } from "@/i18n/ui";
import { getAlternatePath, getUi, localizePath } from "@/i18n/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
const t = getUi(locale);

const initials = profile.displayLines.map((line) => line[0]).join("");
const alternateLocale = LOCALES.find((candidate) => candidate !== locale) ?? locale;

const links = [
	{ id: "about", label: t.nav.about },
	{ id: "projects", label: t.nav.projects },
	{ id: "career", label: t.nav.career },
	{ id: "contact", label: t.nav.contact },
];
---

<NavBar
	client:load
	initials={initials}
	homeLabel={`${initials} — ${profile.name} (${t.backToTop})`}
	sectionLabel={t.nav.label}
	links={links}
	openMenuLabel={t.nav.openMenu}
	closeMenuLabel={t.nav.closeMenu}
	languageLabel={t.nav.switchLanguage}
	alternate={{
		locale: alternateLocale,
		href: getAlternatePath(Astro.url.pathname, alternateLocale),
		label: LOCALE_LABELS[alternateLocale],
	}}
	devHref={localizePath("/dev", locale)}
	devLabel={t.mode.dev}
	devAriaLabel={t.mode.toDev}
/>
