---
import { profile } from "@/data/profile";
import { SiteMode } from "@/types/mode";
import ModeToggle from "./ModeToggle.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-rule">
	<div
		class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-10 font-mono text-sm text-ink-mute sm:flex-row sm:items-center sm:justify-between sm:px-10"
	>
		<p>&copy; {year} {profile.name}</p>
		<div class="flex flex-wrap items-center gap-6">
			{profile.socials.map((social) => (
					<a href={social.url} target="_blank" rel="noreferrer noopener" class="link-accent">
						{social.label}
					</a>
				))}
			<ModeToggle mode={SiteMode.Preview} />
		</div>
	</div>
</footer>
