---
import { ArrowLeft, ArrowRight } from "lucide-react";
import { DEFAULT_LOCALE, type Locale } from "@/i18n/ui";
import { getUi, localizePath } from "@/i18n/utils";
import { SiteMode } from "@/types/mode";

interface Props {
	/** Which mode this toggle is currently rendered in. */
	mode: SiteMode;
	locale?: Locale;
	class?: string;
}

const { mode, locale = DEFAULT_LOCALE, class: className } = Astro.props;
const t = getUi(locale);
const isPreview = mode === SiteMode.Preview;
const target = localizePath(isPreview ? "/dev" : "/", locale);
const label = isPreview ? t.mode.toDev : t.mode.toPreview;
---

<a
	href={target}
	aria-label={label}
	class:list={['link-accent inline-flex h-11 items-center gap-2 font-mono text-sm text-ink-mute', className]}
>
	{isPreview ? (
			<>
				{t.mode.dev}
				<ArrowRight aria-hidden="true" size={14} />
			</>
		) : (
			<>
				<ArrowLeft aria-hidden="true" size={14} />
				{t.mode.preview}
			</>
		)}
</a>
