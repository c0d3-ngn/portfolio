---
import { ArrowLeft, ArrowRight } from "lucide-react";
import { SiteMode } from "@/types/mode";

interface Props {
	/** Which mode this toggle is currently rendered in. */
	mode: SiteMode;
	class?: string;
}

const { mode, class: className } = Astro.props;
const target = mode === SiteMode.Preview ? "/dev" : "/";
const label = mode === SiteMode.Preview ? "Switch to dev mode" : "Switch to preview mode";
---

<a
	href={target}
	aria-label={label}
	class:list={['link-accent inline-flex items-center gap-2 font-mono text-sm text-ink-mute', className]}
>
	{mode === SiteMode.Preview ? (
			<>
				dev
				<ArrowRight aria-hidden="true" size={14} />
			</>
		) : (
			<>
				<ArrowLeft aria-hidden="true" size={14} />
				preview
			</>
		)}
</a>
