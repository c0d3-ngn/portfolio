---
interface Props {
	index: number;
	title: string;
	eyebrow?: string;
}

const { index, title, eyebrow } = Astro.props;
const paddedIndex = String(index).padStart(2, "0");
---

<div class="flex flex-col gap-3">
	<div class="flex items-center gap-3 font-mono text-xs tracking-widest text-accent uppercase">
		<span>{paddedIndex}</span>
		<span aria-hidden="true" class="h-px w-10 bg-accent/60"></span>
		{eyebrow && <span class="text-ink-mute">{eyebrow}</span>}
	</div>
	<h2 data-glitch-line data-glitch-radius="60" class="font-display text-h1 leading-none text-ink">{title}</h2>
</div>

<script>
import "@/lib/glitch-name";
</script>
