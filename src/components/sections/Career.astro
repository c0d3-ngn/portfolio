---
import CareerTimeline, { type CareerEntryData } from "@/components/islands/CareerTimeline";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import type { Locale } from "@/i18n/ui";
import { getUi } from "@/i18n/utils";
import { getCareer } from "@/lib/content";
import { formatCareerPeriod } from "@/lib/format";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);

const roles = await getCareer(locale);
const entries: CareerEntryData[] = roles.map((role) => ({
	id: role.id,
	role: role.data.role,
	company: role.data.company,
	location: role.data.location,
	period: formatCareerPeriod(role.data.start, role.data.end, t.career.present),
	html: role.rendered?.html ?? "",
	stack: role.data.stack,
	current: !role.data.end,
}));
---

<section id="career" class="mx-auto max-w-6xl scroll-mt-12 px-6 py-24 sm:px-10">
	<SectionHeading index={3} title={t.career.heading} />

	<div class="mt-12">
		<CareerTimeline client:visible entries={entries} nowLabel={t.career.now} />
	</div>
</section>
