---
import ProjectGrid, { type ProjectCardData } from "@/components/islands/ProjectGrid";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import type { Locale } from "@/i18n/ui";
import { getUi } from "@/i18n/utils";
import { getProjects } from "@/lib/content";
import { collectSharedKeys } from "@/lib/project-filter";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);

const projects = await getProjects(locale);
const filters = collectSharedKeys(projects.map((project) => project.data.stack));

const cards: ProjectCardData[] = projects.map((project) => ({
	id: project.id,
	title: project.data.title,
	html: project.rendered?.html ?? "",
	stack: project.data.stack,
	repo: project.data.repo,
	demo: project.data.demo,
	featured: project.data.featured,
	preview: project.data.preview,
	previewLabel: project.data.previewLabel,
}));
---

<section id="projects" class="mx-auto max-w-6xl scroll-mt-12 px-6 py-24 sm:px-10">
	<SectionHeading index={2} title={t.projects.heading} />

	<div class="mt-12">
		<ProjectGrid
			client:visible
			projects={cards}
			filters={filters}
			labels={{
				filterLabel: t.projects.filterLabel,
				all: t.projects.filterAll,
				repo: t.projects.repo,
				demo: t.projects.demo,
				featured: t.projects.featured,
			}}
		/>
	</div>
</section>
