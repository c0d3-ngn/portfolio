---
import { ArrowUpRight } from "lucide-react";
import ContactCta from "@/components/islands/ContactCta";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { getProfile } from "@/data/profile";
import type { Locale } from "@/i18n/ui";
import { getUi } from "@/i18n/utils";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
const t = getUi(locale);
---

<section id="contact" class="relative isolate mx-auto max-w-6xl scroll-mt-12 px-6 py-24 sm:px-10">
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-x-0 top-1/3 -z-10 h-96 bg-[radial-gradient(ellipse_60%_100%_at_50%_50%,rgb(232_80_58/10%),transparent)]"
	></div>

	<SectionHeading index={4} title={t.contact.heading} />

	<div class="mt-12 flex flex-col gap-10">
		<p data-reveal class="max-w-xl text-(length:--text-lg) text-ink-mute">{t.contact.intro}</p>

		<ContactCta
			client:visible
			title={t.contact.title}
			email={profile.email}
			labels={{ copy: t.contact.copyEmail, copied: t.contact.copied, send: t.contact.sendEmail }}
		/>

		<div data-reveal>
			<p class="font-mono text-xs tracking-widest text-ink-mute uppercase">{t.contact.socials}</p>
			<ul class="mt-4 grid gap-4 sm:grid-cols-2">
				{profile.socials.map((social) => (
						<li>
							<a
								href={social.url}
								target="_blank"
								rel="noreferrer noopener"
								data-glow
								class="glow-card group flex min-h-20 items-center justify-between gap-4 px-6 py-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
							>
								<span class="flex flex-col">
									<span class="font-display text-h2 leading-tight text-ink">{social.label}</span>
									<span class="font-mono text-sm text-ink-mute">{social.handle}</span>
								</span>
								<ArrowUpRight
									aria-hidden="true"
									size={22}
									className="text-ink-mute transition-all duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-accent"
								/>
							</a>
						</li>
					))}
			</ul>
		</div>
	</div>
</section>

<script>
import "@/lib/glow-cards";
</script>
